<!--
  Per-user MSI installer (no administrator rights needed): installs to
  %LOCALAPPDATA%\Programs\SPVault. Options: Start menu/desktop shortcuts,
  start at Windows sign-in, app language. Build: build_msi.ps1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="SPVault" Manufacturer="Michele Tarducci" Version="$(var.Version)"
           UpgradeCode="{E8EEC9A9-BD40-4F16-BF8D-E8FCBB3F7C0E}" Scope="perUser" Language="1033">
    <!-- installing the same version replaces it: without this the two copies would pile up, and
         with more than one registered the shortcuts could no longer be removed -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of SPVault is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- icon of the shortcuts and of the entry in "Installed apps" (the Id keeps the .ico
         extension: Windows uses it to read the copy it caches for the shortcuts) -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <!-- options: whatever is passed to the installer wins; otherwise the choices made last time
         (upgrades keep them), and on a first installation the defaults -->
    <Property Id="STARTMENUSHORTCUT" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="STARTUP" Secure="yes" />
    <Property Id="INSTALLEDBEFORE">
      <RegistrySearch Id="SearchInstallDir" Root="HKCU" Key="Software\SPVault"
                      Name="InstallDir" Type="raw" />
    </Property>
    <Property Id="PREVSTARTMENU">
      <RegistrySearch Id="SearchStartMenu" Root="HKCU" Key="Software\SPVault"
                      Name="StartMenuShortcut" Type="raw" />
    </Property>
    <Property Id="PREVDESKTOP">
      <RegistrySearch Id="SearchDesktop" Root="HKCU" Key="Software\SPVault"
                      Name="DesktopShortcut" Type="raw" />
    </Property>
    <Property Id="PREVSTARTUP">
      <RegistrySearch Id="SearchStartup" Root="HKCU" Key="Software\SPVault"
                      Name="StartupShortcut" Type="raw" />
    </Property>
    <SetProperty Id="STARTMENUSHORTCUT" Value="1" After="AppSearch" Sequence="both"
                 Condition="NOT STARTMENUSHORTCUT AND (PREVSTARTMENU OR NOT INSTALLEDBEFORE)" />
    <SetProperty Id="DESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="both"
                 Condition="NOT DESKTOPSHORTCUT AND PREVDESKTOP" />
    <SetProperty Id="STARTUP" Value="1" After="AppSearch" Sequence="both"
                 Condition="NOT STARTUP AND (PREVSTARTUP OR NOT INSTALLEDBEFORE)" />
    <Property Id="APPLANGUAGE" Value="auto" Secure="yes">
      <RegistrySearch Id="SearchLanguage" Root="HKCU" Key="Software\SPVault"
                      Name="Language" Type="raw" />
    </Property>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch SPVault" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="SPVault" />
      </Directory>
    </StandardDirectory>

    <!-- per-user install: every component is keyed by an HKCU value -->
    <Component Id="App" Directory="INSTALLFOLDER" Guid="{A2337381-AB19-435A-9F48-CCF9455010C4}">
      <File Id="AppExe" Source="$(var.ExePath)" Name="SPVault.exe" KeyPath="no" />
      <RegistryValue Root="HKCU" Key="Software\SPVault" Name="InstallDir" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
      <!-- language chosen in the installer: the app applies it at startup -->
      <RegistryValue Root="HKCU" Key="Software\SPVault" Name="Language" Type="string"
                     Value="[APPLANGUAGE]" />
      <!-- uninstalling leaves the key empty: it also takes away options of older versions -->
      <RemoveRegistryKey Root="HKCU" Key="Software\SPVault" Action="removeOnUninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder"
               Guid="{30946AC1-22A2-4C7F-9AF1-F71732485FFB}">
      <Shortcut Id="StartMenuLink" Name="SPVault" Target="[INSTALLFOLDER]SPVault.exe" Icon="AppIcon.ico"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\SPVault" Name="StartMenuShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder"
               Guid="{2734291A-435A-427E-9C16-1BDA483D34B3}">
      <Shortcut Id="DesktopLink" Name="SPVault" Target="[INSTALLFOLDER]SPVault.exe" Icon="AppIcon.ico"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\SPVault" Name="DesktopShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartupShortcut" Directory="StartupFolder"
               Guid="{95C7DA0B-FD27-4C10-A9A1-85077DF1AEF3}">
      <Shortcut Id="StartupLink" Name="SPVault" Target="[INSTALLFOLDER]SPVault.exe" Icon="AppIcon.ico"
                Arguments="--minimized" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\SPVault" Name="StartupShortcut" Type="integer"
                     Value="1" KeyPath="yes" />
    </Component>

    <!-- the shortcuts are separate features, so the installer can add or remove them later from
         "Change options" (with conditional components that would not be possible) -->
    <Feature Id="Main" Title="SPVault" Level="1" AllowAbsent="no">
      <ComponentRef Id="App" />
    </Feature>
    <Feature Id="StartMenuShortcutFeature" Title="Start menu shortcut" Level="1">
      <Level Value="0" Condition="NOT STARTMENUSHORTCUT AND NOT Installed" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Level="1">
      <Level Value="0" Condition="NOT DESKTOPSHORTCUT AND NOT Installed" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
    <Feature Id="StartupShortcutFeature" Title="Start at Windows sign-in" Level="1">
      <Level Value="0" Condition="NOT STARTUP AND NOT Installed" />
      <ComponentRef Id="StartupShortcut" />
    </Feature>

    <!-- launch the app at the end of the setup (checkbox on the last page) -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]SPVault.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" />

    <!-- uninstall: also removes the scheduled backup created by the app -->
    <SetProperty Id="RemoveScheduledTask" Before="RemoveScheduledTask" Sequence="execute"
                 Value="&quot;[SystemFolder]schtasks.exe&quot; /Delete /TN &quot;SPVault&quot; /F" />
    <CustomAction Id="RemoveScheduledTask" BinaryRef="Wix4UtilCA_X86" DllEntry="WixQuietExec"
                  Execute="deferred" Return="ignore" Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="RemoveScheduledTask" Before="RemoveFiles"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <UIRef Id="SPVault_UI" />
  </Package>

  <Fragment>
    <UI Id="SPVault_UI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <!-- what to do when the program is already installed -->
      <Property Id="MAINTENANCECHOICE" Value="Repair" />
      <RadioButtonGroup Property="MAINTENANCECHOICE">
        <RadioButton Value="Repair" X="0" Y="0" Width="320" Height="16"
                     Text="Repair: puts back missing or damaged files" />
        <RadioButton Value="Change" X="0" Y="22" Width="320" Height="16"
                     Text="Change options: shortcuts and language" />
        <RadioButton Value="Reinstall" X="0" Y="44" Width="320" Height="16"
                     Text="Reinstall everything: rewrites every program file" />
        <RadioButton Value="Remove" X="0" Y="66" Width="320" Height="16"
                     Text="Uninstall: removes the program and the scheduled backup" />
      </RadioButtonGroup>

      <Dialog Id="MaintenanceChoiceDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Maintenance" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="SPVault is already installed: choose what to do." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Choice" Type="RadioButtonGroup" X="20" Y="70" Width="330" Height="90"
                 Property="MAINTENANCECHOICE" />
        <Control Id="Note" Type="Text" X="20" Y="172" Width="330" Height="50" NoPrefix="yes"
                 Text="The configuration, the session and the backups already made are never touched. To move to a newer version, just run its installer." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <ComboBox Property="APPLANGUAGE">
        <ListItem Value="auto" Text="Automatic (Windows language)" />
        <ListItem Value="it" Text="Italiano" />
        <ListItem Value="en" Text="English" />
      </ComboBox>

      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="Shortcuts, automatic start and language of SPVault." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="StartMenu" Type="CheckBox" X="20" Y="58" Width="330" Height="17"
                 Property="STARTMENUSHORTCUT" CheckBoxValue="1" Text="Create a Start menu shortcut" />
        <Control Id="Desktop" Type="CheckBox" X="20" Y="78" Width="330" Height="17"
                 Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a desktop shortcut" />
        <Control Id="Startup" Type="CheckBox" X="20" Y="98" Width="330" Height="17"
                 Property="STARTUP" CheckBoxValue="1"
                 Text="Start SPVault when I sign in to Windows (minimized)" />

        <!-- the language is chosen on a first installation only: afterwards it is changed in the
             program's window, which is not reinstalled when the shortcuts are changed -->
        <Control Id="LanguageLabel" Type="Text" X="20" Y="126" Width="110" Height="15"
                 Text="App language:" HideCondition="Installed" />
        <Control Id="Language" Type="ComboBox" X="130" Y="123" Width="200" Height="16"
                 Property="APPLANGUAGE" ComboList="yes" HideCondition="Installed" />
        <Control Id="LanguageInstalled" Type="Text" X="20" Y="126" Width="330" Height="15" Hidden="yes"
                 Text="The language is changed in the SPVault window." ShowCondition="Installed" />

        <Control Id="Note" Type="Text" X="20" Y="152" Width="330" Height="70" NoPrefix="yes"
                 Text="The daily automatic backup is set up in the app (Schedule button). It stays active across shutdowns and restarts: if the PC is off at the scheduled time, the backup starts as soon as you turn it back on." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- WixUI_InstallMode decides what the summary page shows (its text and its final button) -->
      <Publish Dialog="WelcomeDlg" Control="Next" Property="WixUI_InstallMode" Value="InstallTypical" Order="0"
               Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Order="1"
               Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg"
               Condition="Installed AND PATCH" />
      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Condition="NOT Installed" />
      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="MaintenanceChoiceDlg"
               Condition="Installed" />
      <!-- options changed on a program already installed: the shortcuts have to be added or
           removed, and the registry values are rewritten to remember the new choices -->
      <Publish Dialog="OptionsDlg" Control="Next" Event="AddLocal" Value="StartMenuShortcutFeature" Order="2"
               Condition="Installed AND STARTMENUSHORTCUT = 1" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="Remove" Value="StartMenuShortcutFeature" Order="2"
               Condition="Installed AND NOT STARTMENUSHORTCUT" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="AddLocal" Value="DesktopShortcutFeature" Order="2"
               Condition="Installed AND DESKTOPSHORTCUT = 1" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="Remove" Value="DesktopShortcutFeature" Order="2"
               Condition="Installed AND NOT DESKTOPSHORTCUT" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="AddLocal" Value="StartupShortcutFeature" Order="2"
               Condition="Installed AND STARTUP = 1" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="Remove" Value="StartupShortcutFeature" Order="2"
               Condition="Installed AND NOT STARTUP" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="1"
               Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="OptionsDlg" Order="2"
               Condition="Installed AND NOT PATCH AND MAINTENANCECHOICE = &quot;Change&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceChoiceDlg" Order="3"
               Condition="Installed AND NOT PATCH AND MAINTENANCECHOICE &lt;&gt; &quot;Change&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2"
               Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceChoiceDlg" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <!-- the boxes start from the shortcuts that are really there ("!" = how they are now,
           "{}" = an empty box) -->
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="STARTMENUSHORTCUT" Value="1" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Change&quot; AND !StartMenuShortcutFeature = 3" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="STARTMENUSHORTCUT" Value="{}" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Change&quot; AND !StartMenuShortcutFeature &lt;&gt; 3" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="DESKTOPSHORTCUT" Value="1" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Change&quot; AND !DesktopShortcutFeature = 3" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="DESKTOPSHORTCUT" Value="{}" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Change&quot; AND !DesktopShortcutFeature &lt;&gt; 3" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="STARTUP" Value="1" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Change&quot; AND !StartupShortcutFeature = 3" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="STARTUP" Value="{}" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Change&quot; AND !StartupShortcutFeature &lt;&gt; 3" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="WixUI_InstallMode" Value="Change" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Change&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="WixUI_InstallMode" Value="Repair" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Repair&quot; OR MAINTENANCECHOICE = &quot;Reinstall&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Property="WixUI_InstallMode" Value="Remove" Order="0"
               Condition="MAINTENANCECHOICE = &quot;Remove&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Event="NewDialog" Value="OptionsDlg"
               Condition="MAINTENANCECHOICE = &quot;Change&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Event="ReinstallMode" Value="ecmus" Order="1"
               Condition="MAINTENANCECHOICE = &quot;Repair&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Event="ReinstallMode" Value="amus" Order="1"
               Condition="MAINTENANCECHOICE = &quot;Reinstall&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Event="Reinstall" Value="ALL" Order="2"
               Condition="MAINTENANCECHOICE = &quot;Repair&quot; OR MAINTENANCECHOICE = &quot;Reinstall&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Event="Remove" Value="All" Order="2"
               Condition="MAINTENANCECHOICE = &quot;Remove&quot;" />
      <Publish Dialog="MaintenanceChoiceDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="3"
               Condition="MAINTENANCECHOICE &lt;&gt; &quot;Change&quot;" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
